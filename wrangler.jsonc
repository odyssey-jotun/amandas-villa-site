{
  "name": "amandas-villa-site",      // must match the Cloudflare Worker name
  "compatibility_date": "2026-10-12",
  "main": "src/worker.js",           // coming-soon switch: shows /coming-soon/ on amandasvilla.com until launch
  "assets": {
    "directory": "./",               // site files live at the repo root (Marc's build scripts expect this)
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,               // set to false after launch
  "preview_urls": true,
  "previews": {}                     // required, or develop preview builds fail
}
